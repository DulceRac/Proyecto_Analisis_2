@startuml

actor Usuario
participant "Cliente / Frontend" as Front
participant "API CRM" as API
participant "ContactoController" as Controller
participant "Modelo Contacto" as Model
database "Base de Datos" as DB

Usuario -> Front : Ingresa datos del contacto
Front -> API : POST /api/contactos\nBearer Token + JSON

API -> API : Validar JWT

alt Token inválido
    API --> Front : 401 Unauthorized
else Token válido
    API -> Controller : crearContacto(datos)
    Controller -> Controller : Validar datos

    alt Datos inválidos
        Controller --> API : Error de validación
        API --> Front : 400 Bad Request
    else Datos válidos
        Controller -> Model : create(datos)
        Model -> DB : INSERT contacto
        DB --> Model : Contacto registrado
        Model --> Controller : Contacto creado
        Controller --> API : Resultado
        API --> Front : 201 Created
        Front --> Usuario : Confirmación
    end
end

@enduml
